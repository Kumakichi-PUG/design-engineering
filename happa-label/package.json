{
  "name": "happa-label",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Label background generator — Voronoi detonation of regular polygons. Derived from happa designtool v1.1.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "d3-delaunay": "^6.0.4",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/culori": "^4.0.1",
    "@types/d3-delaunay": "^6.0.4",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
